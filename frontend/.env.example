# Environment Variables Template
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AEIA backend (SERVER-ONLY) ────────────────────────────────────────────────
# These are read only by the route handlers in src/app/api/aeia/*, which proxy
# browser requests to the FastAPI backend. They are deliberately NOT prefixed
# with NEXT_PUBLIC_: that prefix inlines a value into the client bundle, which
# would publish the backend credential to every visitor.
AEIA_API_URL=http://localhost:8000
AEIA_API_KEY=dev-key-change-me
