# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=campus_connect

# Corpus Path
CORPUS_PATH=./corpus/campus-connect

# API Security
API_KEY=dev-key-change-me
RATE_LIMIT=20/minute

# Langfuse Observability (optional — leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub Webhook (optional — HMAC-SHA256 secret for push event validation)
GITHUB_WEBHOOK_SECRET=
