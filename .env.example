# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Generation models. The first is preferred; the fallbacks are tried only when
# the preferred model is rate-limited or unavailable. JSON list syntax.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=["gemini-2.5-flash","gemini-2.5-flash-lite"]

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=campus_connect
# Seconds before a Qdrant call gives up (prevents indefinite hangs when it is down)
QDRANT_TIMEOUT=10

# Corpus Path
CORPUS_PATH=./corpus/campus-connect

# API Security
API_KEY=dev-key-change-me
RATE_LIMIT=20/minute

# Browser origins allowed to call this API directly (JSON list).
# The Next.js console proxies through its own server, so this only needs to list
# origins that call the API from client-side JavaScript.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Hosts accepted by the MCP endpoint's DNS-rebinding protection (JSON list).
# Must include the hostname the MCP server is actually reached at in production.
MCP_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Logging
LOG_LEVEL=INFO

# Langfuse Observability (optional — leave empty to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub Webhook (optional — HMAC-SHA256 secret for push event validation)
GITHUB_WEBHOOK_SECRET=
